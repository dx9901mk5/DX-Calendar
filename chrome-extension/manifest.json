{
  "manifest_version": 3,
  "name": "DX日曆 (DX-Calendar) — 智慧月曆與跨裝置同步",
  "short_name": "DX日曆",
  "version": "2.1.1",
  "description": "繁中/簡中/英/日四語系三形態日曆：農曆節氣、7天天氣、離線語音、24h雙時區、輪班排班、女性健康與番茄鐘，100% 互通 Android DX日曆 App！",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "DX日曆 (Alt+Shift+D 快速開啟)",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html?mode=sidepanel"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "快速開啟 DX日曆月曆視窗"
    }
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "sidePanel"
  ],
  "host_permissions": [
    "https://api.open-meteo.com/*"
  ]
}
