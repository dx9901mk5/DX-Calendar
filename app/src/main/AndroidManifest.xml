        <activity
            android:name=".alarm.AlarmRingingActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true" />

        <!-- 桌面小工具懸浮透明度與外觀設定視窗 (支援點擊小工具 ⚙ 或桌面長按重新設定) -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.DXCalendar.TranslucentDialog">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- 多重呼叫連段提醒與開機重排程 Receiver -->
        <receiver
            android:name=".alarm.ReminderBroadcastReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="com.dx.calendar.ACTION_FIRE_REMINDER" />
                <action android:name="com.dx.calendar.ACTION_DISMISS_BURST" />
                <action android:name="com.dx.calendar.ACTION_SNOOZE_REMINDER" />
                <action android:name="com.dx.calendar.ACTION_DISMISS_ISLAND" />
                <action android:name="com.dx.calendar.ACTION_UPDATE_DYNAMIC_ICON" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_CHANGED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- 小工具 1：DX 月曆小工具 (支援單週展開動畫、0%-100% 透明度與自由縮放) -->
        <receiver
            android:name=".widget.VivoMonthWidgetProvider"
            android:exported="true"
            android:label="@string/widget_vivo_month_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.dx.calendar.widget.ACTION_PREV_MONTH" />
                <action android:name="com.dx.calendar.widget.ACTION_NEXT_MONTH" />
                <action android:name="com.dx.calendar.widget.ACTION_RESET_TODAY" />
                <action android:name="com.dx.calendar.widget.ACTION_TOGGLE_WEEK_MODE" />
                <action android:name="com.dx.calendar.widget.ACTION_TOGGLE_WEEK_ROW" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_vivo_month_info" />
        </receiver>

        <!-- 小工具 2：DX 時間表可捲動小工具 (支援點擊直達事件、0%-100% 透明度與自由縮放) -->
