                <action android:name="com.dx.calendar.widget.ACTION_RESET_TODAY" />
                <action android:name="com.dx.calendar.widget.ACTION_TOGGLE_TASK" />
                <action android:name="com.dx.calendar.widget.ACTION_CLICK_ITEM" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_google_schedule_info" />
        </receiver>

