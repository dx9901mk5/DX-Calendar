<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_list_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_dark"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_list_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="25 週三"
            android:textColor="#FFF5F5F7"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_list_badge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="時間表"
            android:textColor="#FFFF8A65"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btn_widget_list_add"
            android:layout_width="30dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="＋"
            android:textColor="#FFFF5238"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ListView
        android:id="@+id/widget_list_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="5dp" />

    <TextView
        android:id="@+id/widget_empty_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="近期無公開行程或待辦事項"
        android:textColor="#FF8E8E96"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
