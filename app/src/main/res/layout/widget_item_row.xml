<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/row_date_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="2dp"
        android:shadowColor="#38000000"
        android:shadowDy="0.5"
        android:shadowRadius="0.8"
        android:text="11月25日 週三"
        android:textColor="#FFD0D0DC"
        android:textSize="11.5sp"
        android:textStyle="bold" />

    <FrameLayout
        android:id="@+id/row_card_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/row_card_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/bg_widget_row_dark_solid" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <FrameLayout
                android:id="@+id/row_color_bar"
                android:layout_width="4dp"
                android:layout_height="28dp"
                android:background="#FFFF5238" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/row_item_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:shadowColor="#38000000"
                    android:shadowDy="0.5"
                    android:shadowRadius="0.8"
                    android:text="活動標題"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/row_item_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:paddingTop="2dp"
                    android:shadowColor="#30000000"
                    android:shadowDy="0.5"
                    android:shadowRadius="0.8"
                    android:text="10:00 - 11:00"
                    android:textColor="#FFD4D4DE"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
