<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/row_date_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:paddingBottom="2dp"
        android:text="11月25日 週三"
        android:textColor="#FFA8A8B2"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/row_card_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#28FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <FrameLayout
            android:id="@+id/row_color_bar"
            android:layout_width="4dp"
            android:layout_height="28dp"
            android:background="#FFFF5238" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/row_item_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="活動標題"
                android:textColor="#FFF5F5F7"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/row_item_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="10:00 - 11:00"
                android:textColor="#FFB5B5BE"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
