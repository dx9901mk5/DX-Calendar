<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- 可自由調整 0%~100% 透明度 (setImageAlpha 0..255) 的圓角背景層 -->
    <ImageView
        android:id="@+id/widget_bg_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/bg_widget_dark_solid" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_widget_prev"
                android:layout_width="24dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="‹"
                android:textColor="#FF9E9EA8"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_month_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="3dp"
                android:text="2026/11"
                android:textColor="#FFF5F5F7"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_widget_next"
                android:layout_width="24dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="›"
                android:textColor="#FF9E9EA8"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btn_widget_mode"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginEnd="3dp"
                android:background="#26FFFFFF"
                android:gravity="center"
                android:paddingHorizontal="6dp"
                android:text="單週"
                android:textColor="#FFD8D8E0"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_widget_today"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginEnd="3dp"
                android:background="#2BFF5238"
                android:gravity="center"
                android:paddingHorizontal="7dp"
                android:text="now"
                android:textColor="#FFFF5238"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_widget_config"
                android:layout_width="26dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="⚙"
                android:textColor="#FFA8A8B4"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btn_widget_add"
                android:layout_width="26dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="＋"
                android:textColor="#FFFF5238"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/widget_canvas_img"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="月曆與單週視圖"
                android:scaleType="fitXY" />

            <!-- 6x7 透明點擊格層：支援一般全月格點與類 vivo 手風琴單週展開（每列下方附權重 3 的展開區，與畫布 100% 像素對齊） -->
            <LinearLayout
                android:id="@+id/widget_month_tap_grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingTop="22dp">
                <LinearLayout android:id="@+id/widget_row_0" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
                    <TextView android:id="@+id/widget_cell_00" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
                    <TextView android:id="@+id/widget_cell_01" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
                    <TextView android:id="@+id/widget_cell_02" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
                    <TextView android:id="@+id/widget_cell_03" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
                    <TextView android:id="@+id/widget_cell_04" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
                    <TextView android:id="@+id/widget_cell_05" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
                    <TextView android:id="@+id/widget_cell_06" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
                </LinearLayout>
                <TextView android:id="@+id/widget_row_expand_0" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="3" android:background="@android:color/transparent" android:visibility="gone" />

                <LinearLayout android:id="@+id/widget_row_1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
                    <TextView android:id="@+id/widget_cell_07" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
                    <TextView android:id="@+id/widget_cell_08" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
                    <TextView android:id="@+id/widget_cell_09" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
                    <TextView android:id="@+id/widget_cell_10" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
                    <TextView android:id="@+id/widget_cell_11" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
                    <TextView android:id="@+id/widget_cell_12" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
                    <TextView android:id="@+id/widget_cell_13" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
                </LinearLayout>
                <TextView android:id="@+id/widget_row_expand_1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="3" android:background="@android:color/transparent" android:visibility="gone" />

                <LinearLayout android:id="@+id/widget_row_2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
                    <TextView android:id="@+id/widget_cell_14" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
                    <TextView android:id="@+id/widget_cell_15" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
                    <TextView android:id="@+id/widget_cell_16" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
                    <TextView android:id="@+id/widget_cell_17" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
                    <TextView android:id="@+id/widget_cell_18" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
                    <TextView android:id="@+id/widget_cell_19" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
                    <TextView android:id="@+id/widget_cell_20" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
                </LinearLayout>
                <TextView android:id="@+id/widget_row_expand_2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="3" android:background="@android:color/transparent" android:visibility="gone" />

                <LinearLayout android:id="@+id/widget_row_3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
                    <TextView android:id="@+id/widget_cell_21" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
                    <TextView android:id="@+id/widget_cell_22" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
                    <TextView android:id="@+id/widget_cell_23" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
                    <TextView android:id="@+id/widget_cell_24" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
                    <TextView android:id="@+id/widget_cell_25" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
                    <TextView android:id="@+id/widget_cell_26" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
                    <TextView android:id="@+id/widget_cell_27" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
                </LinearLayout>
                <TextView android:id="@+id/widget_row_expand_3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="3" android:background="@android:color/transparent" android:visibility="gone" />

                <LinearLayout android:id="@+id/widget_row_4" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
                    <TextView android:id="@+id/widget_cell_28" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
                    <TextView android:id="@+id/widget_cell_29" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
                    <TextView android:id="@+id/widget_cell_30" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
                    <TextView android:id="@+id/widget_cell_31" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
                    <TextView android:id="@+id/widget_cell_32" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
                    <TextView android:id="@+id/widget_cell_33" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
                    <TextView android:id="@+id/widget_cell_34" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
                </LinearLayout>
                <TextView android:id="@+id/widget_row_expand_4" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="3" android:background="@android:color/transparent" android:visibility="gone" />

                <LinearLayout android:id="@+id/widget_row_5" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
                    <TextView android:id="@+id/widget_cell_35" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
                    <TextView android:id="@+id/widget_cell_36" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
                    <TextView android:id="@+id/widget_cell_37" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
                    <TextView android:id="@+id/widget_cell_38" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
                    <TextView android:id="@+id/widget_cell_39" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
                    <TextView android:id="@+id/widget_cell_40" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
                    <TextView android:id="@+id/widget_cell_41" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
                </LinearLayout>
                <TextView android:id="@+id/widget_row_expand_5" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="3" android:background="@android:color/transparent" android:visibility="gone" />
            </LinearLayout>

            <!-- 單週展開模式：上方 7 天透明點擊列，點擊任一天直接跳至當日呈現 -->
            <LinearLayout
                android:id="@+id/widget_week_tap_row"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:orientation="horizontal"
                android:paddingTop="14dp"
                android:visibility="gone">
                <TextView android:id="@+id/widget_week_cell_0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
                <TextView android:id="@+id/widget_week_cell_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
                <TextView android:id="@+id/widget_week_cell_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
                <TextView android:id="@+id/widget_week_cell_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
                <TextView android:id="@+id/widget_week_cell_4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
                <TextView android:id="@+id/widget_week_cell_5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
                <TextView android:id="@+id/widget_week_cell_6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
