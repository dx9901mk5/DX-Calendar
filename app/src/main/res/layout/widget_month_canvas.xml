<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_dark"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_widget_prev"
            android:layout_width="26dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="#FF9E9EA8"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_month_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="4dp"
            android:text="2026/11"
            android:textColor="#FFF5F5F7"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_widget_next"
            android:layout_width="26dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="›"
            android:textColor="#FF9E9EA8"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btn_widget_mode"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginEnd="4dp"
            android:background="#26FFFFFF"
            android:gravity="center"
            android:paddingHorizontal="7dp"
            android:text="單週"
            android:textColor="#FFD8D8E0"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_widget_today"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginEnd="4dp"
            android:background="#2BFF5238"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:text="now"
            android:textColor="#FFFF5238"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_widget_add"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="＋"
            android:textColor="#FFFF5238"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_canvas_img"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="月曆與單週視圖"
        android:scaleType="fitXY" />
</LinearLayout>
